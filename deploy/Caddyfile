# The renderer supplies these values in rendered/Caddyfile.
{$SGP_DOMAIN} {
	# /map is an SGP-owned HTML shell served by Next in every environment. The
	# browser then requests BlueMap's native assets/data below /map/*.
	handle /map {
		reverse_proxy 127.0.0.1:{$SGP_WEBSITE_PORT:3000}
	}

	# /map is the only HTML document URL. Do not let /map/ fall through to
	# BlueMap's unmodified generated index.
	handle /map/ {
		respond 404
	}

	# Historical map revisions are immutable files generated offline. Keep them
	# completely outside Next and outside the live BlueMap service.
	handle_path /map-archive/* {
		# Revision paths are content-addressed by an immutable render revision, but
		# manifest.json is the mutable pointer to the currently published revisions.
		header /editions/* Cache-Control "public, max-age=31536000, immutable"
		header /manifest.json Cache-Control "no-cache"

		# Compress text assets generated by BlueMap. Its pre-compressed .gz tile
		# payloads are already compressed and are not selected by Caddy's defaults.
		encode zstd gzip
		root * @map_archive_dir@/public
		file_server
	}

	# Keep high-volume BlueMap assets, map tiles and SSE off the Node process in
	# production. handle_path strips the /map prefix before proxying.
	handle_path /map/* {
		reverse_proxy 127.0.0.1:{$SGP_BLUEMAP_PORT:8100}
	}

	handle {
		reverse_proxy 127.0.0.1:{$SGP_WEBSITE_PORT:3000}
	}
}
