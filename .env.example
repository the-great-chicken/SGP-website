# Local development keeps the SQLite file in the ignored .data directory.
# Production should use an absolute path on a persistent volume.
DATABASE_URL=file:.data/sgp.sqlite

# Discord OAuth. Register the redirect URI in the Discord Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# DiscordSRV's default append-only account-link store.
DISCORDSRV_ACCOUNTS_PATH=../server/plugins/DiscordSRV/accounts.aof

# Private TGCPlugin HTTP bridge. Never prefix these with NEXT_PUBLIC_.
COSMETICS_BRIDGE_URL=http://127.0.0.1:8766
COSMETICS_BRIDGE_SECRET=

# Build-time item rendering. These defaults match sibling TGC_PACK and a standard Windows Minecraft install.
# TGC_RESOURCE_PACK_PATH=../TGC_PACK/TGC_Pack
# MINECRAFT_CLIENT_JAR_PATH=C:/Users/<you>/AppData/Roaming/.minecraft/versions/26.1/26.1.jar

