# Local development keeps the SQLite file in the ignored .data directory.
# Production should use an absolute path on a persistent volume.
DATABASE_URL=file:.data/sgp.sqlite

# Build-time item rendering. These defaults match sibling TGC_PACK and a standard Windows Minecraft install.
# TGC_RESOURCE_PACK_PATH=../TGC_PACK/TGC_Pack
# MINECRAFT_CLIENT_JAR_PATH=C:/Users/<you>/AppData/Roaming/.minecraft/versions/26.1/26.1.jar

